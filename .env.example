# ==============================================================================
# Environment Configuration Template
# Server variables (DO NOT prefix with NEXT_PUBLIC_) are strictly server-only
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000

# Public Application Metadata (safe for client)
NEXT_PUBLIC_APP_NAME="HR Dashboard"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API Gateway
NEXT_PUBLIC_API_BASE_URL=http://localhost:3002/api/v1

# Server-only Secrets (MUST NOT leak to client)
AUTH_SECRET="super-secret-key-at-least-32-chars-long"

# Centralized Logger Configuration
LOG_LEVEL="info"
